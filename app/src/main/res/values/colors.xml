<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- android-use palette (light). Night overrides live in values-night/colors.xml. -->

    <!-- Accent: deep verdigris -->
    <color name="au_primary">#146E74</color>
    <color name="au_on_primary">#FFFFFF</color>
    <color name="au_primary_container">#C7ECEE</color>
    <color name="au_on_primary_container">#032022</color>
    <color name="au_primary_inverse">#6FD3D6</color>

    <!-- Secondary: cool slate -->
    <color name="au_secondary">#4F6367</color>
    <color name="au_on_secondary">#FFFFFF</color>
    <color name="au_secondary_container">#D3E5E8</color>
    <color name="au_on_secondary_container">#0B1E21</color>

    <!-- Tertiary: amber, reserved for "in progress" states -->
    <color name="au_tertiary">#8A5A00</color>
    <color name="au_on_tertiary">#FFFFFF</color>
    <color name="au_tertiary_container">#FFDEA8</color>
    <color name="au_on_tertiary_container">#2C1900</color>

    <!-- Error -->
    <color name="au_error">#B3261E</color>
    <color name="au_on_error">#FFFFFF</color>
    <color name="au_error_container">#F9DEDC</color>
    <color name="au_on_error_container">#410E0B</color>

    <!-- Surfaces: cool neutral with a faint teal cast -->
    <color name="au_background">#F6F8F8</color>
    <color name="au_on_background">#191C1D</color>
    <color name="au_surface">#F6F8F8</color>
    <color name="au_on_surface">#191C1D</color>
    <color name="au_surface_variant">#DCE4E5</color>
    <color name="au_on_surface_variant">#3F4849</color>
    <color name="au_surface_inverse">#2E3132</color>
    <color name="au_on_surface_inverse">#EFF1F1</color>
    <color name="au_surface_dim">#D6DADB</color>
    <color name="au_surface_bright">#F6F8F8</color>
    <color name="au_surface_container_lowest">#FFFFFF</color>
    <color name="au_surface_container_low">#F0F4F4</color>
    <color name="au_surface_container">#EAEEEF</color>
    <color name="au_surface_container_high">#E4E9E9</color>
    <color name="au_surface_container_highest">#DEE3E4</color>
    <color name="au_outline">#6F797A</color>
    <color name="au_outline_variant">#BEC8C9</color>

    <!-- App-specific semantic colors -->
    <!-- "Terminal well" behind monospace blocks (action chip, config, debug log) -->
    <color name="au_code_bg">#E6EDED</color>
    <color name="au_on_code">#1E2A2B</color>
    <!-- Success (task finished, screen ready) -->
    <color name="au_success">#1F6E47</color>
    <color name="au_success_container">#CDEEDB</color>
    <color name="au_on_success_container">#05301B</color>
    <!-- Screen status dot -->
    <color name="au_status_ready">#1F6E47</color>
    <color name="au_status_idle">#6F797A</color>
</resources>
